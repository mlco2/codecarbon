DATABASE_URL=

# Where Account > Settings sends users. Empty means Keycloak's account console,
# {OIDC_ISSUER_URL}/account/; set it for other OIDC providers.
OIDC_ACCOUNT_URL=

# Matomo analytics for server-side events (account created, first run received).
# Off unless both are set. Same instance and site as the webapp's VITE_MATOMO_*.
MATOMO_URL=
MATOMO_SITE_ID=
