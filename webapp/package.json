{
    "name": "codecarbon-webapp",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
